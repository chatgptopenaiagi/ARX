{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arx.local/schemas/project-preflight.schema.json",
  "title": "ARX Project Preflight",
  "type": "object",
  "required": ["generated_at", "provider_inventory_generated_at", "project", "providers", "context", "resolution", "provider_roles", "evaluations", "conflicts", "findings", "severity", "policy", "plan", "explanation"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "provider_inventory_generated_at": {"type": ["string", "null"], "format": "date-time"},
    "project": {"$ref": "project-dna.schema.json"},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "context": {"$ref": "#/$defs/executionContext"},
    "resolution": {"$ref": "#/$defs/resolution"},
    "provider_roles": {"$ref": "#/$defs/providerRoles"},
    "evaluations": {"type": "array", "items": {"$ref": "#/$defs/satisfactionEvaluation"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "severity": {"$ref": "#/$defs/severity"},
    "policy": {"$ref": "#/$defs/policy"},
    "plan": {"$ref": "#/$defs/resolutionPlan"},
    "explanation": {"$ref": "#/$defs/explanationGraph"}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "description": "A sourced capability need whose relevance remains separate from satisfaction."
    },
    "requirementGraph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "capability", "path", "executable_identity", "version", "kind", "discovery_method", "healthy", "confidence", "evidence", "exists", "health_status", "health_reason", "architecture", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^provider:"},
        "capability": {"type": "string"},
        "path": {"type": "string"},
        "executable_identity": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "kind": {"enum": ["cpython", "conda", "uv_managed", "virtual_environment", "windowsapps_alias", "unknown"]},
        "discovery_method": {"type": "string"},
        "healthy": {"type": ["boolean", "null"]},
        "exists": {"type": "boolean"},
        "health_status": {"enum": ["healthy", "degraded", "unhealthy", "unknown"]},
        "health_reason": {"type": ["string", "null"]},
        "architecture": {"type": ["string", "null"]},
        "scope": {"enum": ["user", "machine", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "providerGraph": {
      "type": "object",
      "required": ["capability_ids", "providers", "edges"],
      "properties": {
        "capability_ids": {"type": "array", "items": {"type": "string"}},
        "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "providerRoles": {
      "type": "object",
      "required": ["capability", "resolved_provider_id", "compatible_provider_ids", "preferred_provider_id", "pinned_constraints", "pinned_provider_ids"],
      "properties": {
        "capability": {"type": "string"},
        "resolved_provider_id": {"type": ["string", "null"]},
        "compatible_provider_ids": {"type": "array", "items": {"type": "string"}},
        "preferred_provider_id": {"type": ["string", "null"]},
        "pinned_constraints": {"type": "array", "items": {"type": "string"}},
        "pinned_provider_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "executionContext": {
      "type": "object",
      "required": ["id", "shell", "working_directory", "path_fingerprint", "process_environment_fingerprint", "account_fingerprint", "command", "uv_indicators"],
      "properties": {
        "id": {"type": "string", "pattern": "^execution-context:"},
        "shell": {"type": "string"},
        "working_directory": {"type": "string"},
        "path_fingerprint": {"type": "string"},
        "process_environment_fingerprint": {"type": "string"},
        "account_fingerprint": {"type": ["string", "null"]},
        "command": {"type": "string"},
        "virtual_environment": {"type": "boolean"},
        "conda_environment": {"type": "boolean"},
        "uv_indicators": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["id", "command", "context_id", "context", "resolved_path", "resolved_provider_id", "candidate_provider_ids", "method", "confidence", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^resolution:"},
        "command": {"type": "string"},
        "context_id": {"type": "string"},
        "context": {"$ref": "#/$defs/executionContext"},
        "resolved_path": {"type": ["string", "null"]},
        "resolved_provider_id": {"type": ["string", "null"]},
        "candidate_provider_ids": {"type": "array", "items": {"type": "string"}},
        "method": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "relevance": {"enum": ["required", "optional", "conditionally_required", "not_required", "unknown_relevance"]},
    "satisfaction": {"enum": ["satisfied", "unsatisfied", "partial", "conflict", "ambiguous", "unknown", "optional_unavailable", "not_applicable"]},
    "satisfactionEvaluation": {
      "type": "object",
      "required": ["requirement_id", "relevance", "satisfaction", "resolved_provider_id", "compatible_provider_ids", "unverified_provider_ids", "preferred_provider_id", "reason", "evidence_refs"],
      "properties": {
        "requirement_id": {"type": "string"},
        "relevance": {"$ref": "#/$defs/relevance"},
        "satisfaction": {"$ref": "#/$defs/satisfaction"},
        "resolved_provider_id": {"type": ["string", "null"]},
        "compatible_provider_ids": {"type": "array", "items": {"type": "string"}},
        "unverified_provider_ids": {"type": "array", "items": {"type": "string"}},
        "preferred_provider_id": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["id", "participant_ids", "evidence_refs", "consequence", "confidence", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^ARX-"},
        "participant_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "consequence": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blocks": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "message", "evidence_refs", "matters"],
      "properties": {
        "id": {"type": "string", "pattern": "^ARX-"},
        "message": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "matters": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "object",
      "required": ["severity", "reason", "current_context_satisfaction", "recoverability", "blocker_ids", "warning_ids", "satisfied_count", "warning_count", "blocker_count"],
      "properties": {
        "severity": {"enum": ["green", "yellow", "red"]},
        "reason": {"type": "string"},
        "current_context_satisfaction": {"$ref": "#/$defs/satisfaction"},
        "recoverability": {"enum": ["ready", "recoverable", "blocked", "unknown"]},
        "blocker_ids": {"type": "array", "items": {"type": "string"}},
        "warning_ids": {"type": "array", "items": {"type": "string"}},
        "satisfied_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["host_mutation", "prefer_existing_providers", "prefer_project_local", "global_path_changes", "global_runtime_upgrade", "uninstall_alternative_providers", "windows_security_changes", "prefer_reversible_recommendations"],
      "properties": {
        "host_mutation": {"const": "forbidden"},
        "prefer_existing_providers": {"type": "boolean"},
        "prefer_project_local": {"type": "boolean"},
        "global_path_changes": {"const": "forbidden"},
        "global_runtime_upgrade": {"const": "forbidden"},
        "uninstall_alternative_providers": {"const": "forbidden"},
        "windows_security_changes": {"const": "forbidden"},
        "prefer_reversible_recommendations": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "resolutionPlan": {
      "type": "object",
      "required": ["goal", "steps", "policy_constraints", "automatic_execution"],
      "properties": {
        "goal": {"type": "string"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "action", "reason", "provider_id", "automatic", "reversible"],
            "properties": {
              "id": {"type": "string", "pattern": "^ARX-PLAN-"},
              "action": {"type": "string"},
              "reason": {"type": "string"},
              "provider_id": {"type": ["string", "null"]},
              "automatic": {"const": false},
              "reversible": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "policy_constraints": {"type": "array", "items": {"type": "string"}},
        "automatic_execution": {"const": false}
      },
      "additionalProperties": false
    },
    "explanationGraph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "label", "evidence_refs"],
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["evidence", "requirement", "provider", "resolution", "capability", "conflict", "finding", "consequence", "satisfaction", "severity", "recommendation"]},
              "label": {"type": "string"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["source_id", "target_id", "relation"],
      "properties": {
        "source_id": {"type": "string"},
        "target_id": {"type": "string"},
        "relation": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
