{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chatgptopenaiagi/ARX/schemas/agent-capability-challenge.schema.json",
  "title": "ARX Agent Capability Challenge (experimental)",
  "type": "object",
  "required": ["protocol_version", "challenge_id", "capability_id", "family", "purpose", "scope", "workspace_id", "workspace", "allowed_operations", "forbidden_operations", "timeout_seconds", "expected_evidence", "artifact_expectations", "validator", "fixture_version", "fixtures", "dependencies", "safety_profile", "producer"],
  "properties": {
    "protocol_version": {"const": "agent-challenge/0.1"},
    "challenge_id": {"type": "string", "pattern": "^agent-challenge:[a-f0-9]{24}$"},
    "capability_id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1024},
    "scope": {"$ref": "#/$defs/scope"},
    "workspace_id": {"type": "string", "pattern": "^agent-challenge-workspace:[a-f0-9]{16}$"},
    "workspace": {"type": "string", "minLength": 1},
    "allowed_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 64},
    "forbidden_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 64},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "expected_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 32},
    "artifact_expectations": {"type": "array", "items": {"$ref": "#/$defs/artifactExpectation"}, "maxItems": 32},
    "validator": {"type": "object", "required": ["name", "version"], "additionalProperties": {"type": "string"}},
    "fixture_version": {"type": "string"},
    "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}, "maxItems": 32},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "machine_reference": {"type": ["string", "null"]},
    "execution_context_requirements": {"type": "object", "additionalProperties": {"type": "string"}},
    "safety_profile": {"const": "bounded-disposable-workspace"},
    "producer": {"type": "object", "required": ["name", "version"], "additionalProperties": {"type": "string"}},
    "generated_at": {"type": ["string", "null"]}
  },
  "$defs": {
    "scope": {"type": "object", "required": ["kind", "target", "qualifiers"], "properties": {"kind": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "qualifiers": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false},
    "fixture": {"type": "object", "required": ["relative_path", "size", "sha256", "role"], "properties": {"relative_path": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+$"}, "size": {"type": "integer", "minimum": 0, "maximum": 16777216}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string"}}, "additionalProperties": false},
    "artifactExpectation": {"type": "object", "required": ["relative_path", "required", "executable"], "properties": {"relative_path": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+$"}, "required": {"type": "boolean"}, "expected_size": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216}, "expected_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "expected_text": {"type": ["string", "null"], "maxLength": 16384}, "executable": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
