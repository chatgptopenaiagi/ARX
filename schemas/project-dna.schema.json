{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arx.local/schemas/project-dna.schema.json",
  "title": "ARX Project DNA",
  "type": "object",
  "required": [
    "generated_at",
    "id",
    "identity",
    "root",
    "languages",
    "ecosystems",
    "manifests",
    "requirements",
    "optional_requirements",
    "requirement_edges",
    "requirement_graph",
    "evidence",
    "confidence",
    "unknowns"
  ],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "id": {"type": "string", "pattern": "^project:"},
    "identity": {"type": "string"},
    "root": {"type": "string"},
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ecosystems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "build_systems": {"type": "array", "items": {"type": "string"}},
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "size", "evidence"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        },
        "additionalProperties": false
      }
    },
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "optional_requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "requirement_edges": {"type": "array", "items": {"$ref": "#/$defs/requirementEdge"}},
    "requirement_graph": {"$ref": "#/$defs/requirementGraph"},
    "entrypoint_hints": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "source", "value", "method", "confidence"],
      "properties": {
        "kind": {"enum": ["declared", "observed", "inferred", "unknown"]},
        "source": {"type": "string"},
        "value": {},
        "method": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "note": {"type": ["string", "null"]},
        "capability": {"type": "string"},
        "evidence_type": {"enum": ["requirement", "selection", "dependency_environment", "dependency_requirement", "ci_tested", "inferred"]},
        "source_kind": {"type": "string"},
        "source_path": {"type": "string"},
        "source_key": {"type": "string"},
        "raw": {"type": ["string", "null"], "maxLength": 512},
        "provenance": {"type": "string"}
      },
      "additionalProperties": false
    },
    "requirementEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["capability", "evidence_type", "source_kind", "source_path", "source_key", "raw", "provenance"]
        }
      ]
    },
    "requirement": {
      "type": "object",
      "required": ["id", "capability", "constraint", "source", "field", "relevance", "relation", "evidence_purpose", "confidence", "evidence", "parent_ids", "effective_specifier", "is_effective", "interpretation_state", "conflict_ids", "unknowns"],
      "properties": {
        "id": {"type": "string", "pattern": "^requirement:"},
        "capability": {"type": "string"},
        "constraint": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "field": {"type": "string"},
        "relevance": {"enum": ["required", "optional", "conditionally_required", "not_required", "unknown_relevance"]},
        "relation": {"type": "string"},
        "evidence_purpose": {"enum": ["requirement", "selection", "dependency_resolution", "dependency_requirement", "ci", "inferred_environment"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/requirementEvidence"}},
        "parent_ids": {"type": "array", "items": {"type": "string"}},
        "effective_specifier": {"type": ["string", "null"]},
        "is_effective": {"type": "boolean"},
        "interpretation_state": {"enum": ["interpreted", "unknown", "conflict"]},
        "conflict_ids": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "requirementGraph": {
      "type": "object",
      "required": ["project_root", "requirements_by_capability", "effective_requirement_ids", "provenance_by_requirement", "conflict_ids", "unknowns"],
      "properties": {
        "project_root": {"type": "string"},
        "requirements_by_capability": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "effective_requirement_ids": {"type": "object", "additionalProperties": {"type": "string"}},
        "provenance_by_requirement": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "conflict_ids": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "requirementEdge": {
      "type": "object",
      "required": ["source_id", "target_id", "relation"],
      "properties": {
        "source_id": {"type": "string"},
        "target_id": {"type": "string"},
        "relation": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
