{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chatgptopenaiagi/ARX/security/release-record/release-security-record.schema.json",
  "title": "ARX public release-security record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_state",
    "claim",
    "release_identity",
    "gates",
    "reproducibility",
    "remaining_findings",
    "remaining_blockers",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "arx_release_security_record"},
    "record_state": {"enum": ["TEMPLATE", "FINAL"]},
    "claim": {"const": "ARX passed the following defined security gates."},
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "artifact_version",
        "tag",
        "commit_sha",
        "build_date",
        "audit_date",
        "audit_commit",
        "release_channel",
        "windows_build_environment",
        "python_version"
      ],
      "properties": {
        "product": {"const": "ARX 4"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "artifact_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "tag": {"type": "string", "minLength": 1, "maxLength": 80},
        "commit_sha": {"type": "string", "minLength": 1, "maxLength": 64},
        "build_date": {"type": "string", "minLength": 1, "maxLength": 64},
        "audit_date": {"type": "string", "minLength": 1, "maxLength": 64},
        "audit_commit": {"type": "string", "minLength": 1, "maxLength": 64},
        "release_channel": {"const": "PRERELEASE"},
        "windows_build_environment": {"type": "string", "minLength": 1, "maxLength": 256},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "sdist", "portable_zip", "arx_exe", "installer", "sha256sums"],
      "properties": {
        "wheel": {"$ref": "#/$defs/reproducibilityResult"},
        "sdist": {"$ref": "#/$defs/reproducibilityResult"},
        "portable_zip": {"$ref": "#/$defs/reproducibilityResult"},
        "arx_exe": {"$ref": "#/$defs/reproducibilityResult"},
        "installer": {"$ref": "#/$defs/reproducibilityResult"},
        "sha256sums": {"$ref": "#/$defs/reproducibilityResult"}
      }
    },
    "remaining_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}
      }
    },
    "remaining_blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2048},
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048},
      "uniqueItems": true
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "evidence", "limitation"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "result": {
          "enum": ["PASS", "PASS WITH LIMITATION", "REVIEWED", "NOT APPLICABLE", "BLOCKED", "FAIL"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048},
          "uniqueItems": true
        },
        "limitation": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "reproducibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "evidence", "limitation"],
      "properties": {
        "classification": {
          "enum": [
            "BIT_FOR_BIT_REPRODUCIBLE",
            "STRUCTURALLY_EQUIVALENT",
            "NOT_REPRODUCIBLE",
            "UNRESOLVED"
          ]
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2048},
        "limitation": {"type": ["string", "null"], "maxLength": 2048}
      }
    }
  }
}
